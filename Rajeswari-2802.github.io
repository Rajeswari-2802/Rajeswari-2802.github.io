</head>
<body>
<div class="nebula"></div>
<canvas id="cosmos"></canvas>
<div class="cursor-glow"></div>
<header class="nav">
  <div class="wrap">
    <a href="../index.html" class="brand"><img src="../assets/logo.svg" alt="Rajeswari T logo"><span>RAJESWARI T<small>EMBEDDED // ECE</small></span></a>
