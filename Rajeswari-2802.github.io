<!-- ============ PROJECTS ============ -->
<section id="projects">
  <div class="wrap">
    <div class="eyebrow reveal">02 · Projects</div>
    <h2 class="title reveal d1">Selected <em>builds.</em></h2>
    <p class="lead reveal d2">Each project opens into a full breakdown: the problem, the architecture and the hardware behind it.</p>

    <div class="projects">
      <!-- V2V -->
      <a href="projects/vector-aid.html" class="panel card featured reveal">
        <div>
          <div class="card-top"><span class="card-idx">P/01</span><span class="badge">FINAL YEAR · TEAM</span></div>
          <h3>Vector Aid: V2V Smart Ambulance Alert System</h3>
          <p>Two Raspberry Pi 4 nodes talking over nRF24L01 RF. The ambulance broadcasts its GPS position, heading and route so vehicles ahead get warned before the siren is even audible.</p>
          <div class="tags"><span>Raspberry Pi 4</span><span>nRF24L01</span><span>NEO-M8N GPS</span><span>MPU6050</span><span>OpenRouteService</span><span>Python</span></div>
          <span class="more">View case study <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
        <div class="card-visual">
          <svg viewBox="0 0 320 220">
            <path d="M0 150 H320" stroke="rgba(62,224,122,.18)" stroke-width="40"/>
            <path d="M0 150 H320" stroke="rgba(62,224,122,.5)" stroke-width="1" class="flow"/>
            <g transform="translate(60 132)">
              <rect width="46" height="30" rx="5" fill="#0d2417" stroke="#3ee07a"/>
